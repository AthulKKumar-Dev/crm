# ──────────────────────────────────────────────────────────────────────────────
# Collabo CRM — Docker Compose Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Then start the stack:
#   docker compose up -d
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_USER=collabo
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=collabo_crm
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── App ─────────────────────────────────────────────────────────────────────
APP_PORT=80
FRONTEND_URL=http://localhost
APP_URL=http://localhost

# ─── JWT Secrets (REQUIRED — generate 32+ char random strings) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_32_char_or_longer_string_aaaa
JWT_REFRESH_SECRET=replace_with_different_random_32_char_string_bbbb

# ─── Encryption Key (REQUIRED — exactly 32 characters) ──────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_exactly_32_chars_xxxx

# ─── Email (SMTP via Nodemailer) ────────────────────────────────────────────
# Required in production. In development (NODE_ENV != production) emails are
# logged to console and SMTP is not contacted, so these can be left blank.
#
# Provider quick-reference:
#   Brevo           : host=smtp-relay.brevo.com     port=587  secure=false
#   SendGrid        : host=smtp.sendgrid.net        port=587  secure=false  user=apikey  pass=<SG API key>
#   AWS SES (SMTP)  : host=email-smtp.<region>.amazonaws.com  port=587  secure=false
#   Gmail/Workspace : host=smtp.gmail.com           port=587  secure=false  (App Password required)
#   Mailtrap (test) : host=sandbox.smtp.mailtrap.io port=2525 secure=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@collabo.store
FROM_NAME=Collabo CRM
REPLY_TO_EMAIL=support@collabo.store

# ─── Shopify — Optional ─────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ─── Meta (Instagram + WhatsApp) — Optional ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CONFIG_ID=
