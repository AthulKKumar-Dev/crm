# ──────────────────────────────────────────────────────────────────────────────
# Collabo CRM — Docker Compose Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Then start the stack:
#   docker compose up -d
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_USER=collabo
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=collabo_crm
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── App ─────────────────────────────────────────────────────────────────────
APP_PORT=80
FRONTEND_URL=http://localhost
APP_URL=http://localhost

# ─── JWT Secrets (REQUIRED — generate 32+ char random strings) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_32_char_or_longer_string_aaaa
JWT_REFRESH_SECRET=replace_with_different_random_32_char_string_bbbb

# ─── Encryption Key (REQUIRED — exactly 32 characters) ──────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_exactly_32_chars_xxxx

# ─── Email (Resend) — Optional ──────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@yourcrm.com
FROM_NAME=Collabo CRM

# ─── Shopify — Optional ─────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ─── Meta (Instagram + WhatsApp) — Optional ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CONFIG_ID=
